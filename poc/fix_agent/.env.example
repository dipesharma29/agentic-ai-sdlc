# Copy to .env in this folder. .env is git-ignored.

# --- Gemini through Vertex AI (needs billing linked + Vertex AI API on) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ai-sdlc-515307
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash-lite

# --- Target repo (path inside the container) ---
TARGET_REPO=/app/poc/workspace/agent-poc-sandbox
BASE_BRANCH=main

# --- GitHub (optional; without it the agent commits locally and opens no PR) ---
# Fine-grained token limited to the sandbox repo: Contents + Pull requests (read/write).
GITHUB_REPO=dipesharma29/agent-poc-sandbox
GITHUB_TOKEN=
