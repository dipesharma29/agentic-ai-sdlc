# Copy to .env in this folder. .env is git-ignored.

# --- Gemini through Vertex AI, as service account fix-agent (role: Vertex AI User) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ai-sdlc-515307
# Service account key (git-ignored). Each person gets their own key from the project owner.
GOOGLE_APPLICATION_CREDENTIALS=/app/poc/secrets/fix-agent-key.json
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash-lite

# --- Target repo: a separate clone of this repo (path inside the container) ---
TARGET_REPO=/app/poc/workspace/agentic-ai-sdlc
BASE_BRANCH=main

# --- GitHub (optional; without it the agent commits locally and opens no PR) ---
# Fine-grained token limited to this repo: Contents + Pull requests (read/write).
GITHUB_REPO=dipesharma29/agentic-ai-sdlc
GITHUB_TOKEN=
