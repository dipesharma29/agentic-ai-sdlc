# Copy this file to .env (same folder) and fill in. .env is git-ignored.

# --- Gemini through Vertex AI (needs billing linked on the project) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ai-sdlc-515307
# No region rule was set; us-central1 usually gets new models first. Change if the team prefers.
GOOGLE_CLOUD_LOCATION=us-central1
# Check Model Garden for the current Gemini versions before running.
MODEL=gemini-2.5-flash

# --- Jira (optional; without it, approved stories are saved to prototype/output/stories) ---
JIRA_BASE_URL=https://itmcsystems-team-r6zdxryt.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_PARENT_EPIC=KAN-4

# --- Local copy of the Java repo (default: workspace/spring-petclinic) ---
# REPO_PATH=
